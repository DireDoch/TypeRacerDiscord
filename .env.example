# Variables d'environnement de TypeRacerDiscord.
#
# Copier en `.env` À LA RACINE du dépôt et renseigner, ou exporter dans le shell
# avant `cargo run`. Un seul fichier pour tout le projet : `dotenvy` cherche
# `.env` dans le dossier courant PUIS remonte les parents, donc
# `cd backend && cargo run` le trouve à la racine.
#
# (Le serveur lit l'environnement du process ; aucun secret n'est exposé au client.)
#
# Le frontend lit ce même fichier : `vite.config.ts` pose `envDir: ".."`. Seules
# les variables préfixées `VITE_` entrent dans le bundle client — les secrets
# ci-dessous n'en sortent jamais.

# --- Base de données -------------------------------------------------------
# Fichier SQLite (créé au démarrage si absent). Défaut si non défini : sqlite:typeracer.db
DATABASE_URL=sqlite:typeracer.db

# --- OAuth Discord (scope identify) ----------------------------------------
# Si ces DEUX variables sont absentes/vides → MODE DEV : le Bearer token sert de
# player_id (test local au curl), et POST /token renvoie 503.
# Renseignées → échange réel du code (POST /token) + résolution via /oauth2/@me, qui
# refuse au passage un token émis pour une AUTRE application Discord.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Proxy citations (GET /api/quote) --------------------------------------
# Clé API-Ninjas, injectée côté serveur dans l'en-tête X-Api-Key. Absente/vide →
# GET /api/quote renvoie 502 (proxy non configuré).
APININJAS_API_KEY=

# --- Fichiers statiques (origine unique) -----------------------------------
# Dossier du build Vite servi en fallback (SPA → index.html). Défaut : ../frontend/dist
STATIC_DIR=../frontend/dist

# --- Serveur -----------------------------------------------------------------
# Port d'écoute (127.0.0.1). Défaut : 8080. Utile pour une 2e instance de test.
#PORT=8080

# --- Frontend (Vite) -------------------------------------------------------
# PUBLIC — ce n'est pas un secret, il part en clair dans le bundle. Doit
# correspondre à DISCORD_CLIENT_ID. Absent → MODE DEV côté client : pas de
# handshake Embedded App SDK, tous les joueurs deviennent dev-player-1.
# Vite la FIGE à la compilation : la changer impose un rebuild.
VITE_DISCORD_CLIENT_ID=
